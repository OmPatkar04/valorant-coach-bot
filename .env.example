# Copy this file to ".env" and fill in the values. Never commit ".env".

# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# ID of the text channel where match reports are posted
# (Discord -> Settings -> Advanced -> Developer Mode, then right-click the channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=

# --- HenrikDev Unofficial Valorant API ---------------------------------------
# Your key from the HenrikDev dashboard (sent in the Authorization header)
HENRIK_API_KEY=

# --- Your Valorant account ---------------------------------------------------
# Region / affinity: na, eu, ap, kr, latam, br   (India / Mumbai -> ap)
VALORANT_REGION=ap
# Riot ID split in two: "Name#TAG" -> VALORANT_NAME=Name, VALORANT_TAG=TAG (no "#")
VALORANT_NAME=
VALORANT_TAG=

# --- Optional tuning ---------------------------------------------------------
# Seconds between history checks (minimum 30)
POLL_INTERVAL_SECONDS=180
# Mode sent to the API's "mode" query parameter. If you get an HTTP 400 that
# mentions the mode, try "Competitive" (capitalised).
MATCH_MODE=competitive
# How many recent matches are remembered to judge your playstyle (3-30)
HISTORY_SIZE=10
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
